{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "CyberStrike",
      "options": { "baseURL": "http://localhost:8000/v1", "apiKey": "none" },
      "models": { "cyberstrike": { "name": "CyberStrike-35B" } }
    }
  },
  "model": "local/cyberstrike",
  "mcp": {
    "hexstrike": {
      "type": "local",
      "command": ["__HEXSTRIKE_DIR__/venv/bin/python3", "__HEXSTRIKE_DIR__/hexstrike_mcp.py", "--server", "http://localhost:8888"],
      "enabled": true
    }
  }
}
