{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Pharaoh Local Qwen",
      "options": { "baseURL": "http://localhost:8000/v1", "apiKey": "none" },
      "models": { "__MODEL_ALIAS__": { "name": "Qwen3.8-27B Abliterated", "limit": { "context": 131072, "output": 32768 } } }
    }
  },
  "model": "local/__MODEL_ALIAS__",
  "mcp": {
    "hexstrike": {
      "type": "local",
      "command": ["__HEXSTRIKE_DIR__/venv/bin/python3", "__HEXSTRIKE_DIR__/hexstrike_mcp.py", "--server", "http://localhost:8888"],
      "enabled": true,
      "timeout": 3600000
    }
  }
}
