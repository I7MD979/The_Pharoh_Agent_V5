{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "local": {
      "name": "__PROVIDER_NAME__",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": { "baseURL": "http://127.0.0.1:__MODEL_PORT__/v1", "apiKey": "none" },
      "models": {
        "__MODEL_ALIAS__": {
          "name": "__MODEL_NAME__",
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] },
          "limit": { "context": __MODEL_CONTEXT__, "output": __MODEL_OUTPUT__ }
        }
      }
    }
  },
  "model": "local/__MODEL_ALIAS__",
  "tool_output": { "max_lines": 2000, "max_bytes": 51200 },
  "mcp": {
    "timeout": { "startup": 30000, "catalog": 60000, "execution": 3600000 },
    "servers": {
      "hexstrike": {
        "type": "remote",
        "url": "http://127.0.0.1:__HEXSTRIKE_MCP_BRIDGE_PORT__/mcp",
        "oauth": false,
        "codemode": true,
        "timeout": { "execution": 3600000 }
      }
    }
  }
}
