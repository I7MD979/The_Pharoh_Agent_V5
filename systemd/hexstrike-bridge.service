[Unit]
Description=HexStrike MCP bridge — streamable-http daemon on :8890
# The bridge talks to the HexStrike FastAPI server on :8888, so keep it ordered
# after it. Requires= also brings it up automatically with the parent service.
After=hexstrike.service
Requires=hexstrike.service

[Service]
Type=simple
User=__STACK_USER__
Group=__STACK_USER__
WorkingDirectory=__HEXSTRIKE_DIR__
ExecStart=__HEXSTRIKE_DIR__/venv/bin/python3 __HEXSTRIKE_DIR__/hexstrike_mcp.py --server http://localhost:8888
# Long-lived MCP daemon: if it ever wedges, bounce it immediately. opencode
# reconnects by itself on the next tool call (every call is a fresh HTTP request,
# so there is no shared pipe state to corrupt across sessions).
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
