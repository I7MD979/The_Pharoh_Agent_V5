[Unit]
Description=Pharaoh llama.cpp server (Q8_0)
After=network.target
Wants=network.target

[Service]
Type=simple
User=__STACK_USER__
Group=__STACK_GROUP__
WorkingDirectory=__STACK_HOME__
Environment=LD_LIBRARY_PATH=__LLAMA_LIBDIR__
ExecStart=__LLAMA_BIN__ \
  -m __MODEL_FILE__ \
  --alias __MODEL_ALIAS__ \
  --host __MODEL_HOST__ --port __MODEL_PORT__ \
  -c __MODEL_CONTEXT__ -ngl 999 \
  --flash-attn on --cache-type-k q8_0 --cache-type-v q8_0 --jinja \
  --reasoning on --reasoning-effort xhigh --reasoning-preserve \
  --slots --metrics \
  --temp 1.0 --top-p 0.95 --top-k 20 --min-p 0.0
Restart=on-failure
RestartSec=10
# Allow large model + KV cache
LimitMEMLOCK=infinity
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
